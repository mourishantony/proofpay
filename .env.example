# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's Webhooks section (needed only for /api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
CURRENCY=USD
PLATFORM_FEE_PERCENT=0

# --- AI agent ---
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise deterministic rules mode
AI_MODE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
QA_PASS_SCORE=80

# --- App ---
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15
